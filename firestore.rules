rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /submissions/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['ritual', 'process', 'idea', 'name', 'ts'])
        && request.resource.data.ritual is string
        && request.resource.data.process is string
        && request.resource.data.idea is string
        && request.resource.data.idea.size() > 0 && request.resource.data.idea.size() < 2000
        && request.resource.data.name is string && request.resource.data.name.size() < 120
        && request.resource.data.ts is number;
      allow update, delete: if false;
    }

    match /customRituals/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['title', 'blurb', 'elements', 'addedBy', 'ts'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() < 120
        && request.resource.data.blurb is string && request.resource.data.blurb.size() < 300
        && request.resource.data.addedBy is string && request.resource.data.addedBy.size() < 120
        && request.resource.data.ts is number;
      allow update, delete: if false;
    }

    match /customProcesses/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['title', 'blurb', 'addedBy', 'ts'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() < 120
        && request.resource.data.blurb is string && request.resource.data.blurb.size() < 300
        && request.resource.data.addedBy is string && request.resource.data.addedBy.size() < 120
        && request.resource.data.ts is number;
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
